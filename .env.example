# PayHere merchant credentials (server-side only — never expose the secret to the client).
# Get these from your PayHere merchant dashboard: https://www.payhere.lk/merchant/
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# "sandbox" while testing, "live" once you're ready to accept real payments.
PAYHERE_MODE=sandbox

# EmailJS — sends the bank-transfer details email straight from the browser,
# no backend needed. Get these from your EmailJS dashboard: https://dashboard.emailjs.com/admin
# The public key is safe to expose client-side by design (same idea as a
# Firebase apiKey) — it only authorizes sending through your own configured
# service/template.
VITE_EMAILJS_SERVICE_ID=service_042u64s
VITE_EMAILJS_TEMPLATE_ID=template_8wikfne
VITE_EMAILJS_PUBLIC_KEY=suR-80SR-om21gCzS
