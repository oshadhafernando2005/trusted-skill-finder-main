# PayHere merchant credentials (server-side only — never expose the secret to the client).
# Get these from your PayHere merchant dashboard: https://www.payhere.lk/merchant/
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# "sandbox" while testing, "live" once you're ready to accept real payments.
PAYHERE_MODE=sandbox

# Public https URL of this site, no trailing slash. PayHere calls
# ${SITE_URL}/api/payhere-notify to confirm payments, so it can't be localhost
# (use a tunnel such as ngrok when testing locally).
SITE_URL=https://bookingpro.lk
