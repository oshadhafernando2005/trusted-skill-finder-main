+function expandLegacyOneToOneAvailability(items: EditAvailabilityItem[]): EditAvailabilityItem[] {
+  const result: EditAvailabilityItem[] = [];
+  const horizon = nextTwoWeekDates();
+
+  for (const item of items) {
+    if (item.date) {
+      result.push(item);
+      continue;
+    }
+
+    const matchingDates = horizon.filter((date) => weekdayFromDate(date) === item.day);
+    for (const date of matchingDates) {
+      result.push({ ...item, date, day: weekdayFromDate(date) });
+    }
+  }
+
+  return result;
+}
