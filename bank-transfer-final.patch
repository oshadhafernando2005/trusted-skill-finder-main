-+  }
-+
-+  const ref = await addDoc(collection(db, "bookings"), {
-+    ...data,
-+    notes: data.notes ?? "",
-+    paymentMethod: "bank_transfer",
-+    status: "booked",
-+    createdAt: serverTimestamp(),
-+  });
-+
-+  return { bookingId: ref.id };
-+}
