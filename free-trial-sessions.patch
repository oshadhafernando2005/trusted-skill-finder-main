diff --git a/src/lib/trial-booking.server.ts b/src/lib/trial-booking.server.ts
new file mode 100644
index 0000000..b091de0
--- /dev/null
+++ b/src/lib/trial-booking.server.ts
@@ -0,0 +1,130 @@
+import { z } from "zod";
+
+import { createFreeTrialBookingAdmin } from "@/lib/bookings.server";
+import { sendBookingEmails } from "@/lib/email.server";
+import { getAdmin } from "@/lib/firebase-admin.server";
+import {
+  MAX_TRIAL_BOOKINGS_PER_CLIENT,
+  generateTrialSlots,
+  normalizeTrialSessions,
+} from "@/lib/trial-sessions";
+
+// Server-only: the checks and writes behind booking a free trial session. Kept
+// apart from trial.functions.ts so the rules can be tested on their own.
+
+export type CreateTrialBookingInput = {
+  professionalId: string;
+  date: string;
+  timeSlot: string;
+  customerName: string;
+  customerEmail: string;
+  customerPhone: string;
+  notes?: string;
+};
+
+const inputSchema = z.object({
+  professionalId: z.string().min(1).max(200),
+  date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
+  timeSlot: z.string().regex(/^\d{2}:\d{2}–\d{2}:\d{2}$/),
+  customerName: z.string().trim().min(2, "Enter your full name").max(80),
+  customerEmail: z.string().trim().email("Enter a valid email").max(255),
+  customerPhone: z.string().trim().min(6, "Enter a valid phone number").max(30),
+  notes: z.string().trim().max(500).optional(),
+});
+
+// Nothing is trusted from the browser except who is booking and which slot: the
+// professional, their trial windows, the price (always free) and the 15-minute
+// length all come from the server, so this can't be used to book a paid slot
+// for free.
+export async function bookTrialSession(raw: CreateTrialBookingInput) {
+  const parsed = inputSchema.safeParse(raw);
+  if (!parsed.success) {
+    throw new Error(parsed.error.issues[0]?.message ?? "Please check your details.");
+  }
+  const data = parsed.data;
+  const email = data.customerEmail.toLowerCase();
+
+  const { db } = await getAdmin();
+  const proSnap = await db.collection("professionals").doc(data.professionalId).get();
+  const pro = proSnap.data();
+  if (!proSnap.exists || !pro || pro.status !== "approved") {
+    throw new Error("This professional is no longer available.");
+  }
+
+  // The slot must be one of the 15-minute blocks inside a trial window the
+  // professional really offers.
+  const [slotStart, slotEnd] = data.timeSlot.split("–");
+  const offered = normalizeTrialSessions(pro.trialSessions).some(
+    (window) =>
+      window.date === data.date &&
+      generateTrialSlots(window.startTime, window.endTime).some(
+        (s) => s.start === slotStart && s.end === slotEnd,
+      ),
+  );
+  if (!offered) {
+    throw new Error("That trial session isn't offered. Please refresh and pick a time again.");
+  }
+
+  // Times are Sri Lanka time (UTC+05:30) — see zoom.server.ts.
+  if (new Date(`${data.date}T${slotStart}:00+05:30`).getTime() <= Date.now()) {
+    throw new Error("That time has already started. Please pick a later trial session.");
+  }
+
+  // Soft limit so one client can't hoard every free slot.
+  const earlier = await db
+    .collection("bookings")
+    .where("professionalId", "==", data.professionalId)
+    .where("customerEmail", "==", email)
+    .where("isTrial", "==", true)
+    .get();
+  const activeTrials = earlier.docs.filter((d) => d.data().status === "confirmed").length;
+  if (activeTrials >= MAX_TRIAL_BOOKINGS_PER_CLIENT) {
+    throw new Error(
+      "You've already booked a free trial with this professional. Book a full session to continue.",
+    );
+  }
+
+  const professionalName = typeof pro.fullName === "string" ? pro.fullName : "Professional";
+  const currency = typeof pro.currency === "string" && pro.currency ? pro.currency : "LKR";
+  const sessionType =
+    Array.isArray(pro.sessionType) && typeof pro.sessionType[0] === "string"
+      ? pro.sessionType[0]
+      : "Online video";
+
+  const { bookingId } = await createFreeTrialBookingAdmin({
+    professionalId: data.professionalId,
+    professionalName,
+    amount: 0,
+    currency,
+    sessionType,
+    sessionMode: "one_to_one",
+    sessionName: "Trial session",
+    groupCapacity: 1,
+    date: data.date,
+    timeSlot: data.timeSlot,
+    customerName: data.customerName,
+    customerEmail: email,
+    customerPhone: data.customerPhone,
+    notes: data.notes ?? "",
+  });
+
+  // Never throws — a mail problem must not undo a booking that succeeded.
+  await sendBookingEmails(bookingId, {
+    professionalId: data.professionalId,
+    professionalName,
+    date: data.date,
+    timeSlot: data.timeSlot,
+    sessionName: "Trial session",
+    sessionType,
+    amount: 0,
+    currency,
+    customerName: data.customerName,
+    customerEmail: email,
+    customerPhone: data.customerPhone,
+    notes: data.notes ?? "",
+    meetingLink: null,
+    isTrial: true,
+  });
+
+  return { bookingId };
+}
diff --git a/src/lib/trial-sessions.ts b/src/lib/trial-sessions.ts
new file mode 100644
index 0000000..53291a6
--- /dev/null
+++ b/src/lib/trial-sessions.ts
@@ -0,0 +1,128 @@
+import { z } from "zod";
+
+import {
+  TRIAL_MINUTES,
+  generateSlots,
+  toLocalISODate,
+  toMinutes,
+  toTimeString,
+  weekdayShortFromDate,
+  windowsOverlap,
+  type TimeSlot,
+} from "@/lib/slots";
+
+// A trial session is a free, 15-minute one-to-one session a professional offers
+// so a client can meet them before paying for a full session. The professional
+// sets a window (a date plus a start and end time); it's cut into back-to-back
+// 15-minute blocks, and each block is booked on its own without payment.
+export type TrialSession = { date: string; startTime: string; endTime: string };
+
+// How many trial bookings one client (matched by email) may hold with the same
+// professional. Raise it, or set it to Infinity, to allow more.
+export const MAX_TRIAL_BOOKINGS_PER_CLIENT = 1;
+
+// "09:00"–"10:00" -> 09:00–09:15, 09:15–09:30, 09:30–09:45, 09:45–10:00.
+export function generateTrialSlots(startTime: string, endTime: string): TimeSlot[] {
+  const start = toMinutes(startTime);
+  const end = toMinutes(endTime);
+  const slots: TimeSlot[] = [];
+  if (Number.isNaN(start) || Number.isNaN(end) || end <= start) return slots;
+  for (let cursor = start; cursor + TRIAL_MINUTES <= end; cursor += TRIAL_MINUTES) {
+    slots.push({ start: toTimeString(cursor), end: toTimeString(cursor + TRIAL_MINUTES) });
+  }
+  return slots;
+}
+
+export const trialSessionsSchema = z
+  .array(
+    z.object({
+      date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/, "Pick a date for each trial session"),
+      startTime: z.string().min(1, "Set a start time for each trial session"),
+      endTime: z.string().min(1, "Set an end time for each trial session"),
+    }),
+  )
+  .max(30, "You can add up to 30 trial session windows")
+  .superRefine((items, ctx) => {
+    const today = toLocalISODate(new Date());
+    for (const item of items) {
+      if (item.date < today) {
+        ctx.addIssue({ code: "custom", message: "Trial session dates can't be in the past" });
+        return;
+      }
+      if (generateTrialSlots(item.startTime, item.endTime).length === 0) {
+        ctx.addIssue({
+          code: "custom",
+          message: `Each trial session window must be at least ${TRIAL_MINUTES} minutes long`,
+        });
+        return;
+      }
+    }
+    for (let i = 0; i < items.length; i++) {
+      for (let j = i + 1; j < items.length; j++) {
+        if (windowsOverlap(items[i], items[j])) {
+          ctx.addIssue({
+            code: "custom",
+            message: `Two trial session windows overlap on ${items[i].date}`,
+          });
+          return;
+        }
+      }
+    }
+  })
+  .default([]);
+
+// Reads the saved list back from Firestore, dropping anything malformed.
+export function normalizeTrialSessions(raw: unknown): TrialSession[] {
+  if (!Array.isArray(raw)) return [];
+  return raw
+    .filter((item): item is Record<string, unknown> => typeof item === "object" && item !== null)
+    .map((item) => ({
+      date: typeof item.date === "string" ? item.date : "",
+      startTime: typeof item.startTime === "string" ? item.startTime : "",
+      endTime: typeof item.endTime === "string" ? item.endTime : "",
+    }))
+    .filter(
+      (item) =>
+        /^\d{4}-\d{2}-\d{2}$/.test(item.date) &&
+        generateTrialSlots(item.startTime, item.endTime).length > 0,
+    );
+}
+
+// A professional can only run one session at a time, so a trial window must not
+// overlap their one-to-one slots or group sessions. Returns a readable message
+// for the first clash, or null.
+export function findTrialScheduleConflict(
+  trialSessions: TrialSession[],
+  oneToOneAvailability: Array<{
+    day: string;
+    date?: string;
+    startTime: string;
+    endTime: string;
+    removedSlots?: string[];
+    slots?: TimeSlot[];
+  }>,
+  groupSessions: Array<{ date: string; startTime: string; endTime: string }>,
+): string | null {
+  for (const trial of trialSessions) {
+    const weekday = weekdayShortFromDate(trial.date);
+    for (const day of oneToOneAvailability) {
+      if (day.date ? day.date !== trial.date : day.day !== weekday) continue;
+      const slots = day.slots?.length ? day.slots : generateSlots(day.startTime, day.endTime);
+      const removed = new Set(day.removedSlots ?? []);
+      const clash = slots.find(
+        (slot) =>
+          !removed.has(slot.start) &&
+          windowsOverlap(trial, { date: trial.date, startTime: slot.start, endTime: slot.end }),
+      );
+      if (clash) {
+        return `The trial session on ${trial.date} (${trial.startTime}–${trial.endTime}) overlaps your one-to-one slot ${clash.start}–${clash.end}.`;
+      }
+    }
+    for (const group of groupSessions) {
+      if (windowsOverlap(trial, group)) {
+        return `The trial session on ${trial.date} (${trial.startTime}–${trial.endTime}) overlaps your group session at ${group.startTime}–${group.endTime}.`;
+      }
+    }
+  }
+  return null;
+}
